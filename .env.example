# Long random string used to sign login sessions (e.g. `openssl rand -base64 32`)
AUTH_SECRET=

# Users allowed to sign in, separated by ";" — username:password
# For a hashed password run: npm run hash-password -- <username> <password>
AUTH_USERS=ibrahim:change-me

# Set automatically when you add Upstash Redis from the Vercel Marketplace.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
